# CLIENT ENVIRONMENT VARIABLES

# Base URL for backend HTTP API requests.
# If backend runs locally on port 3000, keep this value.
VITE_API_URL=http://localhost:3000/api

# Link shown in the UI footer (your GitHub profile or repo).
VITE_GITHUB_URL=https://github.com/yourusername/quiz

# Frontend app URL (Vite dev server URL).
VITE_URL=http://localhost:5173

# Backend socket.io server URL (usually same host/port as backend).
VITE_SOCKET_URL=http://localhost:3000
