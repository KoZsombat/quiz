# SERVER ENVIRONMENT VARIABLES

# MySQL host (usually localhost on your own machine).
DB_HOST=localhost

# MySQL username.
DB_USER=root

# MySQL password.
# Leave empty only if your local MySQL user has no password.
DB_PASSWORD=

# Name of the database used by this project.
DB_NAME=quiz

# Backend server port.
PORT=3000

# Frontend origin allowed by CORS.
# Must match your frontend URL exactly.
CORS_ORIGIN=http://localhost:5173

# Secret key used to sign JWT tokens.
# Replace with a long random string in real projects.
JWT_SECRET=change_this_to_a_long_random_secret

# Public URL where this backend is reachable.
# Used by socket/server internal requests.
API_URL=http://localhost:3000
